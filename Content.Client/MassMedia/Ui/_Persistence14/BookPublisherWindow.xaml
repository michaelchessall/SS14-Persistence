<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    Title="{Loc 'book-publisher-ui-title'}"
    MinSize="300 250"
    SetSize="300 250">

    <BoxContainer Orientation="Vertical" Margin="10">
        <!-- Book status -->
        <BoxContainer Orientation="Vertical" Margin="0 0 0 10">
            <Label Text="{Loc 'book-publisher-book-status'}" StyleClasses="Bold"/>
            <Label Name="BookStatus" Text="{Loc 'book-publisher-no-book'}" Margin="0 5 0 0"/>
        </BoxContainer>

        <!-- Title input -->
        <BoxContainer Orientation="Vertical" Margin="0 0 0 10">
            <Label Text="{Loc 'book-publisher-title-label'}" StyleClasses="Bold"/>
            <LineEdit Name="TitleInput" Margin="0 5 0 0" ToolTip="{Loc 'book-publisher-title-tooltip'}"/>
        </BoxContainer>

        <!-- Actions -->
        <BoxContainer Orientation="Horizontal">
            <Button Name="PublishButton" Text="{Loc 'book-publisher-publish'}" Margin="0 0 10 0"/>
            <Button Name="EjectButton" Text="{Loc 'book-publisher-eject'}"/>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>