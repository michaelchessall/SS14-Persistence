<PanelContainer xmlns="https://spacestation14.io" HorizontalExpand="True" MinHeight="30" Margin="10 10 10 0">
    <BoxContainer HorizontalExpand="True" Orientation="Vertical">
        <Label Name="TitleLabel" Text="Metafaction Title" StyleClasses="LabelKeyText" />
        <BoxContainer Orientation="Horizontal" >
            <Label Text="Rank: " StyleClasses="LabelKeyText" />
            <RichTextLabel Name="RankTitle" Text="Rank Name" />
        </BoxContainer>
        <ProgressBar Name="LevelBar"
                    HorizontalExpand="True"
                    MaxValue="1"
                    MinValue="0"
                    SetHeight="25"
                    Margin="10 5 10 5"
                    VerticalAlignment="Center">
            <RichTextLabel Name="ContentLabel" Text="Rep Content" />
        </ProgressBar>
    </BoxContainer>
</PanelContainer>
